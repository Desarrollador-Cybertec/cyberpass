APP_NAME=CyberPass
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=your-supabase-host.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-password
DB_SCHEMA=public
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=5
DB_PERSISTENT=false
DB_DISABLE_PREPARES=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# Credential Encryption (32 bytes base64)
CREDENTIAL_ENCRYPTION_KEY=

# Sanctum
#
# OJO: este valor es TAMBIEN la duracion del bloqueo por sesion unica.
# AuthService::findActiveToken() considera "activa" cualquier sesion creada
# dentro de estos minutos y attemptLogin() responde 409 mientras dure, asi que
# quien pierda su token (equipo nuevo, otro navegador, datos borrados) se queda
# fuera exactamente este tiempo. No lo subas pensando solo en comodidad: 120
# significa dos horas de bloqueo, no dos horas de sesion comoda.
#
# 20-30 es el rango sensato. Comprueba el valor real de un entorno con:
#   php artisan tinker --execute="echo config('sanctum.expiration');"
SANCTUM_TOKEN_EXPIRATION=20

# Tokens de integración (apps externas: Axis)
# Vida por defecto y máxima de un token de integración, y cuántos puede tener
# activos cada persona a la vez.
INTEGRATION_TOKEN_DAYS=365
INTEGRATION_TOKEN_MAX_DAYS=730
INTEGRATION_MAX_TOKENS_PER_USER=10
